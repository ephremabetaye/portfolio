MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/video_portfolio?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$12$replace_with_generated_hash
SESSION_SECRET=replace_with_a_long_random_string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS — optional. The contact form always saves messages to Admin → Messages;
# these make it also email you. You can also set these in Admin → Settings instead
# (settings take priority, no rebuild needed). Verify the IDs at emailjs.com.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=