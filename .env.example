MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/video_portfolio?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$12$replace_with_generated_hash
SESSION_SECRET=replace_with_a_long_random_string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS — the contact form always saves messages to Admin → Messages, and the
# server also sends two emails: a notification to you (Send To Email) and an
# automatic reply to the sender's own email address.
# You can also set Service/Template/Public Key in Admin → Settings instead
# (settings take priority, no rebuild needed). Verify the IDs at emailjs.com.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_5r1x8h6
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_3cd95gb
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=w6kpXNWa3b0sOiHR8

# Optional — a separate template for auto-replies and replies sent from
# Admin → Messages. Its "To Email" must be {{to_email}}.
# EMAILJS_AUTO_REPLY_TEMPLATE_ID=

# Optional — your EmailJS private key (dashboard → Account → Security).
# Only needed if your account enables "API access from non-browser environments" / strict mode.
# EMAILJS_PRIVATE_KEY=
