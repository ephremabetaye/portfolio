# ---------------------------------------------------------------------------
# Copy these values into Vercel → Project → Settings → Environment Variables.
# .env files are NOT uploaded to Vercel.
# ---------------------------------------------------------------------------

# REQUIRED in production. MongoDB Atlas connection string.
# If this is empty on Vercel, public pages have no data (missing images/projects)
# and the contact form cannot save messages.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/video_portfolio?retryWrites=true&w=majority

# REQUIRED for admin login. ADMIN_EMAIL is the email you type in the login form.
ADMIN_EMAIL=admin@example.com

# Either a raw bcrypt hash ($2b$12$...) or its base64 form.
# Generate one with: npm run hash:admin -- "YourPassword"
# The base64 form is recommended because `$` can be mangled by dotenv loaders.
ADMIN_PASSWORD_HASH=PASTE_BASE64_HASH_HERE

# OPTIONAL fallback if the hash was copied incorrectly. Less secure than the
# hash, but lets you recover access quickly. Remove it once login works.
# ADMIN_PASSWORD=YourPassword

# REQUIRED. Any long random string. Changing it logs out every admin session.
SESSION_SECRET=replace_with_a_long_random_string

# Set this to your deployed URL (or leave empty on Vercel — the app falls back
# to VERCEL_PROJECT_PRODUCTION_URL automatically for email links/sitemap).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# OPTIONAL. Force demo content when MongoDB is not configured (useful for a
# quick preview). Contact messages and admin edits are NOT durable on Vercel
# in this mode because the filesystem is read-only.
# DEMO_MODE=true

# EmailJS — the contact form always saves messages to Admin → Messages, and the
# server also sends two emails: a notification to you (Send To Email) and an
# automatic reply to the sender's own email address.
# You can also set Service/Template/Public Key in Admin → Settings instead
# (settings take priority, no rebuild needed). Verify the IDs at emailjs.com.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_5r1x8h6
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_3cd95gb
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=w6kpXNWa3b0sOiHR8

# Optional — a separate template for auto-replies and replies sent from
# Admin → Messages. Its "To Email" must be {{to_email}}.
# EMAILJS_AUTO_REPLY_TEMPLATE_ID=

# Optional — your EmailJS private key (dashboard → Account → Security).
# Only needed if your account enables "API access from non-browser environments" / strict mode.
# EMAILJS_PRIVATE_KEY=
